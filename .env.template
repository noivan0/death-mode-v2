# DEATH MODE v2 — .env template
# Copy to .env (gitignored). Do NOT commit .env.
#
#   cp .env.template .env && chmod 600 .env
#   # edit .env, then:
#   bash scripts/manage_env.sh status
#   bash scripts/manage_env.sh expand
#
# Lighter API keys: https://app.zklighter.com → Settings → API Keys
# Mainnet L2 chainId = 304 / testnet = 300

# ── Lighter account ──────────────────────────────────
# Example: 1058
LIGHTER_ACCOUNT_INDEX=
# Example: 0
LIGHTER_API_KEY_INDEX=
# mainnet=304, testnet=300
LIGHTER_CHAIN_ID=304
# LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai

# ── Lighter credentials ──────────────────────────────
# Public API key (hex, usually 80 chars; 0x optional)
LIGHTER_API_KEY=
# Private API key (80 hex) — never share / never commit
LIGHTER_API_SECRET=
# Alias used by exchange_patch (same value as LIGHTER_API_SECRET)
LIGHTER_PRIVATE_KEY=

# ── SSL ──────────────────────────────────────────────
# HMG corp MitM only: 1 ; public internet: 0
LIGHTER_SKIP_SSL_VERIFY=0

# ── Optional ─────────────────────────────────────────
# LIGHTER_RPC_URL=https://mainnet.zklighter.elliot.ai

