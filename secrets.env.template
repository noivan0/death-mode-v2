# DEATH MODE v2 — Lighter Exchange Secrets
# =====================================================
# 이 파일을 복사해서 secrets.env 로 저장하세요.
# secrets.env는 절대 git에 커밋하지 마세요!
# .gitignore에 "secrets.env" 추가 필수.
#
# Lighter 계정 정보 확인 방법:
#   1. https://app.zklighter.com 접속
#   2. Connect Wallet → Settings → API Keys
#   3. Account Index: 상단 계정 번호
#   4. API Key Index: API Keys 탭의 Key Index 번호
#   5. Chain ID: Lighter mainnet L2 = 304 / testnet = 300
# =====================================================

# ── Lighter 계정 정보 ────────────────────────────────
LIGHTER_ACCOUNT_INDEX=           # 예: 1058
LIGHTER_API_KEY_INDEX=           # 예: 2
LIGHTER_CHAIN_ID=304             # mainnet=304, testnet=300 (절대 혼동 금지)
# LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai

# ── Lighter API 자격증명 ──────────────────────────────
LIGHTER_API_KEY=                 # Lighter API Key (0x...)
LIGHTER_API_SECRET=              # Lighter Private Key (0x... — 절대 공유 금지!)

# ── SSL 검증 (환경별 설정) ────────────────────────────
# HMG 사내망(MitM 인증서 환경): 1
# 외부망(일반 인터넷): 0 또는 생략
LIGHTER_SKIP_SSL_VERIFY=0        # 기본값: SSL 검증 활성화

# ── 선택 설정 ─────────────────────────────────────────
# LIGHTER_RPC_URL=https://mainnet.zklighter.elliot.ai

# ── Hyperliquid (실전) ────────────────────────────────
# HYPERLIQUID_WALLET_ADDRESS=0x...
# HYPERLIQUID_PRIVATE_KEY=0x...

# ── Cardinal Risk Cage (자율운영) ─────────────────────
# DM_STRATEGY=DeathModeV2_Cardinal
# DM_MAX_RISK=0.005          # 트레이드당 계좌 리스크 0.5%
# DM_MAX_DAY_LOSS=0.02       # 일일 손실 2% → kill switch
# DM_MIN_RR=2.0              # 최소 보상:위험
# DM_MIN_CONFIDENCE=0.6
# DM_SHRINK_FACTOR=0.5       # 손절 후 다음 사이즈 50%
# DM_TILT_BLOCK=70           # tilt score ≥ 70 → block
# DM_TILT_COOLDOWN_MIN=40
# DM_ASSET_STOP_COOLDOWN_H=3
