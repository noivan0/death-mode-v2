# DEATH MODE v2 — .gitignore
#
# .env / secrets.env는 절대 git에 커밋하지 마세요!
# 계정 정보, private key 포함. Canonical: .env

# 비밀 설정
.env
secrets.env
*.env
!secrets.env.template
!.env.template

# Freqtrade 데이터 (거래 DB, 로그)
user_data/data/
user_data/logs/
user_data/*.sqlite
user_data/*.sqlite-shm
user_data/*.sqlite-wal
user_data/tradesv3*.sqlite*

# NFI 전략 파일 (로컬용 — 레포에는 포함됨)

# config 실제 파일 (template만 추적)
config/lighter_futures.json
config/binance_futures.json
config/bybit_futures.json
config/bitget_futures.json
config/okx_futures.json
config/okx_live_cardinal.json
config/hyperliquid_futures.json
config/hl_paper_ict.json
config/hl_backtest_spot.json
config/backtest.json
config/backtest_10pairs.json
config/bt_death_10pairs.json

# Docker override
docker-compose.override.yml

# Python 캐시 (재귀)
**/__pycache__/
**/*.pyc

# PID 파일
.pids/

# Cardinal risk / tilt runtime state
user_data/risk_state.json
user_data/tilt_state.json
user_data/logs/journal.csv

# 백테스트 ZIP (원본 유지, 압축 해제 결과는 추적)
user_data/backtest_results/*.zip

# Live runtime config (contains privateKey after expand)
config/lighter_live_cardinal.json
