{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "_comment": "DEATH MODE v2 \u2014 Hyperliquid Config (envsubst \ud15c\ud50c\ub9bf)",
  "max_open_trades": 5,
  "stake_currency": "USDC",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "cancel_open_orders_on_exit": true,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.05,
  "candle_type_def": "futures",
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "stoploss": "limit",
    "stoploss_on_exchange": false,
    "stoploss_on_exchange_interval": 60
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "exchange": {
    "name": "hyperliquid",
    "key": "${HL_WALLET_ADDRESS}",
    "secret": "${HL_PRIVATE_KEY}",
    "ccxt_config": {
      "verify": false,
      "walletAddress": "${HL_WALLET_ADDRESS}",
      "privateKey": "${HL_PRIVATE_KEY}",
      "rateLimit": 500
    },
    "ccxt_async_config": {
      "verify": false,
      "walletAddress": "${HL_WALLET_ADDRESS}",
      "privateKey": "${HL_PRIVATE_KEY}",
      "rateLimit": 500
    },
    "pair_whitelist": [
      "BTC/USDC:USDC",
      "ETH/USDC:USDC",
      "SOL/USDC:USDC",
      "HYPE/USDC:USDC",
      "SUI/USDC:USDC",
      "XRP/USDC:USDC",
      "ZEC/USDC:USDC",
      "LIT/USDC:USDC",
      "VVV/USDC:USDC"
    ],
    "pair_blacklist": [
      "TON/USDC:USDC"
    ]
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  }
}
